# ---- Backend ----
# Local dev (matches docker-compose.yml Postgres service)
DATABASE_URL=postgresql+psycopg://conflict:conflict@localhost:5432/conflict

# Guards all admin write endpoints via the X-Admin-Token header.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=replace-me-with-a-long-random-string

# ACLED ingestion (set ACLED_ENABLED=true to activate)
ACLED_ENABLED=false
ACLED_USERNAME=
ACLED_PASSWORD=
ACLED_LOOKBACK_DAYS=90
ACLED_CRISIS_EVENT_THRESHOLD=10

# GDELT supplementary event stream (set GDELT_ENABLED=true to activate)
GDELT_ENABLED=false

# ReliefWeb situation reports — free, no key needed; register an appname at
# https://apidoc.reliefweb.int/parameters#appname to identify your app.
RELIEFWEB_APPNAME=

# UCDP GED ingestion — attach-only (events are attached to existing
# ACLED/fixture crises within UCDP_ATTACH_RADIUS_KM). Never creates
# standalone crises. Request a token at https://ucdp.uu.se/apidocs/
UCDP_ENABLED=false
UCDP_TOKEN=
UCDP_LOOKBACK_DAYS=730
UCDP_GED_VERSION=25.1
UCDP_ATTACH_RADIUS_KM=150
GDELT_ATTACH_RADIUS_KM=300
GDELT_LOOKBACK_MINUTES=180

# Active crises with no event in this many days are demoted to `frozen`
# at the end of each ingest run. Set to 0 to disable.
STATUS_STALE_DAYS=90

# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
# Referenced as VITE_API_URL in the frontend; lives in frontend/.env for Vite.
# Put it here for documentation; copy into frontend/.env.local if you change the API host.
VITE_API_URL=http://localhost:8000
