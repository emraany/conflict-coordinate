# ---- Backend ----
# Local dev (matches docker-compose.yml Postgres service)
DATABASE_URL=postgresql+psycopg://conflict:conflict@localhost:5432/conflict

# Guards all admin write endpoints via the X-Admin-Token header.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=replace-me-with-a-long-random-string

# ACLED OAuth — unused until the ACLED ingestion adapter is wired up.
ACLED_USERNAME=
ACLED_PASSWORD=

# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
# Referenced as VITE_API_URL in the frontend; lives in frontend/.env for Vite.
# Put it here for documentation; copy into frontend/.env.local if you change the API host.
VITE_API_URL=http://localhost:8000
